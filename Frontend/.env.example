# ===========================================
# Bid Intelligence Frontend - Optional
# Copy to .env to run on network IP / production
# ===========================================

# Backend API port (default 8000; set to match your backend, e.g. uvicorn)
# VITE_API_PORT=8000

# Force API host (e.g. server IP). If unset, browser uses current hostname.
# VITE_API_HOST=192.168.1.5

# Full API URL for build/SSR fallback (e.g. when not in browser)
# VITE_API_BASE_URL=http://192.168.1.5:3000

# Dev server only: proxy target for /api (default 127.0.0.1:3000)
# VITE_PROXY_TARGET=http://192.168.1.5:3000
