# Ollama (AI)
OLLAMA_BASE_URL=http://172.16.200.30:11434
OLLAMA_MODEL=llama3.2

GEMINI_API_KEY=your_gemini_api_key_here

# Server Config
PORT=3000
NODE_ENV=production
MAX_FILE_SIZE_MB=50

# Database Config (PostgreSQL - Optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Bid2
DATABASE_URL=

# MongoDB Config (Required)
MONGODB_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bid_intelligence

# JWT Secret (Generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here
