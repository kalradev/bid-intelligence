# --- LLM: Sarvam (if SARVAM_API_KEY is set, it is used; else OpenAI / Azure) ---
SARVAM_API_KEY=
# SARVAM_BASE_URL=https://api.sarvam.ai/v1
# SARVAM_CHAT_MODEL=sarvam-105b

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# Optional per-task models (default: OPENAI_CHAT_MODEL)
# LLM_MODEL_SUMMARY=
# LLM_MODEL_ELIGIBILITY=
# LLM_MODEL_OEM=
# LLM_MODEL_ROW=

# Server Config
PORT=3000
NODE_ENV=production
MAX_FILE_SIZE_MB=50

# Database Config (PostgreSQL - Optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Bid2
DATABASE_URL=

# MongoDB Config (Required)
MONGODB_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bid_intelligence

# JWT Secret (Generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here
