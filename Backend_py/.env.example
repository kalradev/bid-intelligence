# ===========================================
# Bid Intelligence Backend - Environment Config
# Copy this to .env and fill in your values
# ===========================================

# --- Ollama (Required for AI features) ---
OLLAMA_BASE_URL=http://172.16.200.30:11434
OLLAMA_MODEL=llama3.2

GEMINI_API_KEY=your_gemini_api_key_here

# --- Server Config ---
PORT=3000
# Use PORT=3001 if 3000 is already in use
NODE_ENV=development
MAX_FILE_SIZE_MB=50

# --- CORS (Deployment) ---
# Use * for development. For production, set your frontend URL(s):
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# --- PostgreSQL (Primary Database - Required) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Bid2

# Optional: Override with full connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- JWT (Required for auth) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_key_here

# --- Versioning ---
PROCESSING_VERSION=31
