# ===========================================
# Bid Intelligence Backend - Environment Config
# Copy this to .env and fill in your values
# ===========================================

# --- API Keys (Required for AI features) ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Server Config ---
PORT=3000
# Use PORT=3001 if 3000 is already in use
NODE_ENV=development
MAX_FILE_SIZE_MB=50

# --- CORS (Deployment) ---
# Use * for development. For production, set your frontend URL(s):
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# --- PostgreSQL (Primary Database - Required) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
# Use 127.0.0.1 if DB on same machine; use network IP or hostname if DB on another server
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=Bid2

# Optional: Override with full connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- JWT (Required for auth) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_key_here

# --- Optional: external services (use network IP for production) ---
# CHATBOT_API_URL=http://192.168.1.10:8080

# --- Microsoft Outlook (credentials email on user creation) ---
# Azure app: Application permission Mail.Send, admin consent. Mailbox must exist in tenant.
MICROSOFT_CLIENT_ID=your_azure_client_id
MICROSOFT_CLIENT_SECRET=your_azure_client_secret
MICROSOFT_TENANT_ID=your_azure_tenant_id
MICROSOFT_MAILBOX=no-reply@yourdomain.com

# --- Credentials email branding (optional) ---
# Login link in email (e.g. https://yourdomain.com/login). If unset, link uses placeholder.
# FRONTEND_URL=https://yourdomain.com
# Logo image URL for email (hosted PNG recommended). If unset, shows "Bid Intelligence" text.
# LOGO_URL=https://yourdomain.com/logo.png

# --- Versioning ---
PROCESSING_VERSION=31
