# ===========================================
# Bid Intelligence Backend - Environment Config
# Copy this to .env and fill in your values
# ===========================================

# --- LLM: Sarvam (preferred if set) or OpenAI / Azure ---
# Sarvam: https://docs.sarvam.ai — OpenAI-compatible chat at api.sarvam.ai/v1
SARVAM_API_KEY=
# SARVAM_BASE_URL=https://api.sarvam.ai/v1
# SARVAM_CHAT_MODEL=sarvam-105b
# Alternative: sarvam-30b

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# Optional per-task models:
# LLM_MODEL_SUMMARY=
# LLM_MODEL_ELIGIBILITY=
# LLM_MODEL_OEM=
# LLM_MODEL_ROW=

# --- Server Config ---
PORT=3000
# Use PORT=3001 if 3000 is already in use
NODE_ENV=development
MAX_FILE_SIZE_MB=50

# --- CORS (Deployment) ---
# Use * for development. For production, set your frontend URL(s):
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# --- PostgreSQL (Primary Database - Required) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Bid2

# Optional: Override with full connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- JWT (Required for auth) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_key_here

# --- Versioning ---
PROCESSING_VERSION=31
